@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "_Layoutsystem";
}
@model List<ECApp.Model.Data.Orders>;


<div class="mb-4 text-center">
    <h2 class="fw-bold text-dark"><i class="bi bi-cart-check-fill text-primary"></i> Orders Management</h2>
    <p class="text-muted">Track and manage all customer orders. Quick stats above, full details inside modal.</p>
</div>

<!-- 🔹 Summary Cards -->
<div class="row g-3 mb-4 text-center">
    <div class="col-md">
        <div class="card shadow-sm border-0 bg-light-warning h-100">
            <div class="card-body">
                <h6 class="text-warning fw-bold mb-1"><i class="bi bi-hourglass-split"></i> Pending</h6>
                <p class="text-muted small mb-1">Orders waiting for confirmation</p>
                <h3 class="fw-bold text-dark">@ViewBag.Pending</h3>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card shadow-sm border-0 bg-light-primary h-100">
            <div class="card-body">
                <h6 class="text-primary fw-bold mb-1"><i class="bi bi-check-circle"></i> Confirmed</h6>
                <p class="text-muted small mb-1">Orders confirmed by admin</p>
                <h3 class="fw-bold text-dark">@ViewBag.Confirmed</h3>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card shadow-sm border-0 bg-light-info h-100">
            <div class="card-body">
                <h6 class="text-info fw-bold mb-1"><i class="bi bi-truck"></i> Shipped</h6>
                <p class="text-muted small mb-1">Orders on the way</p>
                <h3 class="fw-bold text-dark">@ViewBag.Shipped</h3>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card shadow-sm border-0 bg-light-secondary h-100">
            <div class="card-body">
                <h6 class="text-secondary fw-bold mb-1"><i class="bi bi-box-seam"></i> Out for Delivery</h6>
                <p class="text-muted small mb-1">Orders being delivered</p>
                <h3 class="fw-bold text-dark">@ViewBag.OutforDelivery</h3>
            </div>
        </div>
    </div>
    <div class="col-md">
        <div class="card shadow-sm border-0 bg-light-success h-100">
            <div class="card-body">
                <h6 class="text-success fw-bold mb-1"><i class="bi bi-bag-check"></i> Delivered</h6>
                <p class="text-muted small mb-1">Successfully completed orders</p>
                <h3 class="fw-bold text-dark">@ViewBag.Deliveryred</h3>
            </div>
        </div>
    </div>
</div>

<!-- 🔹 Orders Table -->
<div id="alertPlaceholder" class="my-3"></div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="d-flex justify-content-between mb-3">
            <h5 class="fw-bold text-dark"><i class="bi bi-list-ul"></i> All Orders</h5>
            <span class="badge bg-dark rounded-pill px-3 py-2">📦 @Model.Count() Orders</span>
        </div>
        <table id="OrderTable" class="table table-hover align-middle table-bordered">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Order ID</th>
                    <th>User</th>
                    <th>Total Price</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var item in Model)
                {
                    <tr>
                        <td>#@item.OrderId</td>
                        <td>@item.UserName</td>
                        <td class="fw-bold text-success">$@item.TotalPrice.ToString("N2")</td>
                        <td>
                            <span class="badge 
                                @(item.StatusName == "Pending" ? "bg-warning" : 
                                  item.StatusName == "Confirmed" ? "bg-primary" :
                                  item.StatusName == "Shipped" ? "bg-info" :
                                  item.StatusName == "Out for Delivery" ? "bg-secondary" :
                                  item.StatusName == "Delivered" ? "bg-success" : "bg-dark")">
                                @item.StatusName
                            </span>
                        </td>
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-outline-primary btn-details"
                                data-id="@item.OrderId"
                                data-bs-toggle="modal"
                                data-bs-target="#orderDetailsModal">
                            <i class="bi bi-eye"></i> Details
                        </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-warning btn-change-status"
                                    data-id="@item.OrderId"
                                    data-status="@item.StatusName">
                                <i class="bi bi-pencil-square"></i> Change
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger btn-delete-modal"
                                    data-order-id="@item.OrderId"
                                    data-bs-toggle="modal"
                                    data-bs-target="#removeModal">
                                <i class="fas fa-trash-alt"></i> Remove
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-success">
                                <i class="fas fa-edit"></i> Update
                            </button>
                    </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 🔹 Order Details Modal -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-4 border-0">

            <!-- Header -->
            <div class="modal-header bg-gradient bg-primary text-white rounded-top-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-receipt-cutoff me-2"></i> Order Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body p-4">
                <div class="row g-4">

                    <!-- Customer & Order Info -->
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-person-circle me-2"></i> Customer Info</h6>
                                <p><strong>Name:</strong> <span id="orderUser"></span></p>
                                <p><strong>Address:</strong> <span id="orderAddress"></span></p>
                                <p><strong>Status:</strong> <span id="orderStatus" class="badge px-3 py-2"></span></p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-body">
                                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle me-2"></i> Order Info</h6>
                                <p><strong>Date:</strong> <span id="orderDate"></span></p>
                                <p><strong>Total:</strong> <span id="orderTotal" class="fw-bold text-success fs-5"></span></p>
                            </div>
                        </div>
                    </div>
                </div>
                

                <!-- Products Table -->
                <div class="mt-4">
                    <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-box-seam me-2"></i> Products</h6>
                    <div class="table-responsive">
                        <table class="table align-middle table-hover shadow-sm rounded-3 overflow-hidden">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:100px;">Image</th>
                                    <th>Product</th>
                                    <th>Product Code</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>
                            <tbody id="orderProducts">
                                <!-- Products will be loaded here dynamically -->
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>



<!-- 🔹 Change Status Modal -->
<div class="modal fade" id="changeStatusModal" tabindex="-1">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content shadow-lg rounded-4 border-0">

            <div class="modal-header bg-gradient bg-warning text-dark rounded-top-4">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-pencil-square me-2"></i> Change Order Status
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body p-4">
                <input type="hidden" id="statusOrderId" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Select New Status</label>
                    <select id="newStatus" class="form-select shadow-sm">
                        <option value="1004">Pending</option>
                        <option value="1005">Confirmed</option>
                        <option value="1007">Shipped</option>
                        <option value="1008">
                            Out for Delivery
                        </option>
                        <option value="1009">Delivered</option>
                    </select>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="saveStatusBtn" class="btn btn-warning fw-bold">
                    <i class="bi bi-check2-circle"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ✅ مودال الحذف -->
<div class="modal fade" id="removeModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="deleteUserModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this user? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post">
                    <input type="hidden" id="orderIdToDelete" />
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>


<script>
     var table = $('#OrderTable').DataTable({
        pageLength: 10,
        lengthMenu: [5, 10, 25, 50, 100],
        ordering: true,
        searching: true,
        info: true,

        // ✅ ترتيب: dropdown (lengthMenu) + بحث + كبسات فوق
        dom:
            "<'row mb-3 align-items-center'<'col-md-3 d-flex justify-content-start'l><'col-md-5 d-flex justify-content-center'f><'col-md-4 d-flex justify-content-end'B>>" +
            "<'row'<'col-12'tr>>" +
            "<'row mt-3'<'col-md-6'i><'col-md-6 d-flex justify-content-end'p>>",

        buttons: [
            {
                extend: 'copyHtml5',
                text: '<i class="bi bi-clipboard"></i> COPY',
                className: 'btn btn-outline-secondary btn-sm'
            },
            {
                extend: 'excelHtml5',
                text: '<i class="bi bi-file-earmark-excel"></i> EXCEL',
                className: 'btn btn-outline-success btn-sm '
            },
            {
                extend: 'pdfHtml5',
                text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                className: 'btn btn-outline-danger btn-sm ',
                orientation: 'landscape',
                pageSize: 'A4'
            },
            {
                extend: 'print',
                text: '<i class="bi bi-printer"></i> PRINT',
                className: 'btn btn-outline-dark btn-sm '
            }
        ],
        language: {
            search: "",
            searchPlaceholder: "🔎 Search Orders.....",
            lengthMenu: "Show _MENU_",   // 👈 هذا اللي بظهر dropdown
            info: "Showing _START_ to _END_ of _TOTAL_ products",
            paginate: {
                previous: "← Prev",
                next: "Next →"
            }
        }
    });

    // ✅ خلي البحث يتمدد
    $('#productTable_filter').parent().addClass('flex-grow-1');
    $('#productTable_filter').addClass('w-100 d-flex');
    $('#productTable_filter label').addClass('w-100 d-flex');
    $('#productTable_filter input')
        .addClass('form-control shadow-sm px-4 py-2 rounded-pill w-100')
        .attr("placeholder", "🔎  Type product name, category, or code...");


    // ✅ تنسيق الـ Dropdown
    $('#productTable_length select')
        .addClass('form-select form-select-sm rounded-pill shadow-sm')
        .css({ 'width': '80px', 'display': 'inline-block' });
        // ✅ مسافة بين الكبسات
    $('.dt-buttons .btn').css({
        'margin-left': '0.4rem',
        'margin-right': '0.4rem'
    });
    $('.dt-buttons').removeClass('btn-group');



           $(document).on("click", ".btn-details", function (e) {
        e.preventDefault(); // ❌ منع أي تنقل

        var orderId = $(this).data("id");

        $.ajax({
            url: '@Url.Action("DetailsOrder", "OrderManagController1")',   // ✅ استدعاء الـ Action فقط
            type: 'GET',
            data: { orderId: orderId },
            success: function (data) {
                // تعبئة بيانات الطلب
                $("#orderStatus")
                    .text(data.statusName)
                    .removeClass()
                    .addClass("badge " + getStatusBadge(data.statusName));

                $("#orderUser").text(data.userName);
                $("#orderAddress").text(data.shippingAddress);
                $("#orderDate").text(data.createdAt);
                $("#orderTotal").text("$" + data.totalPrice.toFixed(2));

                // المنتجات
                var rows = "";
                $.each(data.products, function (i, p) {
                    rows += `
                        <tr>
                            <td><img src="${p.imageUrl}" class="img-thumbnail" style="width:100px;height:60px;"/></td>
                            <td>${p.productName}</td>
                            <td>${p.sku}</td>
                            <td>${p.quantity}</td>
                            <td>$${p.price.toFixed(2)}</td>
                            <td>$${p.subtotal.toFixed(2)}</td>
                        </tr>`;
                });
                $("#orderProducts").html(rows);
            }
        });
    });


    // ✅ Helper Function: Badge Style حسب الحالة
    function getStatusBadge(status) {
        switch (status) {
            case "Pending": return "bg-warning";
            case "Confirmed": return "bg-primary";
            case "Shipped": return "bg-info";
            case "Out for Delivery": return "bg-secondary";
            case "Delivered": return "bg-success";
            default: return "bg-dark";
        }
    }


        // افتح المودال مع القيم الحالية
    $(document).on("click", ".btn-change-status", function () {
        var orderId = $(this).data("id");
        var currentStatus = $(this).data("status");

        $("#statusOrderId").val(orderId);
        $("#newStatus").val(currentStatus); // خلي القيمة الحالية مختارة
    });



    $(document).on("click", ".btn-change-status", function () {
        var orderId = $(this).data("id");
        var currentStatus = $(this).data("status");

        Swal.fire({
            title: 'Change Order Status',
            text: "Order #" + orderId,
            icon: 'question',
            input: 'select',
            inputOptions: {
                'Pending': 'Pending',
                'Confirmed': 'Confirmed',
                'Shipped': 'Shipped',
                'Out for Delivery': 'Out for Delivery',
                'Delivered': 'Delivered'
            },
            inputValue: currentStatus,
            showCancelButton: true,
            confirmButtonText: 'Save',
            cancelButtonText: 'Cancel',
            confirmButtonColor: '#f59f00',
            preConfirm: (newStatus) => {
                return $.ajax({
                    url: '@Url.Action("UpdateStatus", "OrderManagController1")',
                    type: 'POST',
                    data: { orderId: orderId, statusId: newStatus }
                }).then(function (res) {
                    if (!res.success) {
                        Swal.showValidationMessage(`❌ Failed to update`);
                    }
                    return res;
                });
            }
        }).then((result) => {
            if (result.isConfirmed && result.value.success) {
                var newStatus = $("#swal2-select").val();

                // ✅ عدّل الحالة بالجدول مباشرة
                var row = $("#OrderTable button[data-id='" + orderId + "']").closest("tr");
                row.find("td:nth-child(4) span")
                   .text(newStatus)
                   .removeClass()
                   .addClass("badge " + getStatusBadge(newStatus));

                Swal.fire({
                    title: '✅ Updated!',
                    text: 'Order status changed successfully.',
                    icon: 'success',
                    timer: 1500,
                    showConfirmButton: false
                });
            }
        });
    });

        $('.btn-delete-modal').on('click', function () {
        var orderId = $(this).data('order-id');
        $('#orderIdToDelete').val(orderId);
    });

    $('#confirmDeleteBtn').on('click', function (e) {
        e.preventDefault();

        var orderId = $('#orderIdToDelete').val();
        $.ajax({
            url: '@Url.Action("Remove", "OrderManagController1")',
            type: 'POST',
            data: { Id: orderId },
               success: function (response) {
        if (response.success) {
            showAlert(response.message, "success");
            $('#removeModal').modal('hide');
            setTimeout(() => location.reload(), 1500);
        } else {
            showAlert(response.message, "danger");
            $('#removeModal').modal('hide');
            setTimeout(() => location.reload(), 1500);

        }
    }
        });
    });


    function showAlert(message, type = 'success') {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            $('#alertPlaceholder').html(alertHtml);

            setTimeout(() => {
                $('.alert').alert('close');
            }, 4000);
        }
</script>