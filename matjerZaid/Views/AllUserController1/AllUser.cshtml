    <div class="row ">
        <div class="col-lg-6">
        <div class="card shadow">
  <div class="card-body">
   <div>
  <canvas id="myChart"></canvas>
</div>
  </div>
</div>
        </div>
        <div class="col-lg-6">
        <div class="card shadow">
  <div class="card-body">
   <div>
  <canvas id="zaid"></canvas>
</div>
  </div>
</div>
        </div>
    </div>

    <div class=" mt-2 mb-4 " id="1">
    <div class="card shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <strong>Total Users:</strong> @totalUsers <br />
                        <small class="text-success">Confirmed: @confirmedUsers</small> |
                        <small class="text-danger">Not Confirmed: @unconfirmedUsers</small>
                    </div>
                </div>

                <!-- ✅ تنبيه من Bootstrap -->
<div id="alertPlaceholder" class="my-3"></div>
            <div class="table-responsive-sm table-responsive-md" style="">
                    <table id="productTable" class="table  table-responsive table-hover table-striped table-sm table-centered mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Address</th>
                            <th>Email</th>
                            <th>Email Confirmed</th>
                            <th>Phone Number</th>
                            <th>Created At</th>
                              <th>Roles</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pair in Model.Select((item, index) => new { item, index }))
                        {
                            <tr>
                                <td>@(pair.index + 1)</td>
                                <td>@pair.item.FirstName</td>
                                <td>@pair.item.LastName</td>
                                <td>@pair.item.Address</td>
                                <td>@pair.item.Email</td>
                                <td>
                                    <span class="badge @(pair.item.EmailConfirmed ? "badge-success rounded-pill d-inline" : "badge-danger rounded-pill d-inline")">
                                        @(pair.item.EmailConfirmed ? "Confirmed" : "Not Confirmed")
                                    </span>
                                </td>
                                <td>@pair.item.PhoneNumber</td>
                                <td>@pair.item.CreateAt</td>
                                <td>
                                     <span class="badge rounded-pill d-inline 
        @(pair.item.RolsName == "Admin" ? "badge-danger" : 
          pair.item.RolsName == "Sales" ? "badge-primary" : 
          pair.item.RolsName == "Client" ? "badge-success" : "badge-secondary")">
        @pair.item.RolsName
    </span>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 10px;">
                                       <div class="edit-user-btn"
     data-user-id="@pair.item.Id"
     style="background-color: #e3f2fd; padding: 8px; border-radius: 50%;"
     data-bs-toggle="modal"
     data-bs-target="#editUserModal">
    <i class="fas fa-edit" style="color: #1976d2; cursor: pointer;"></i>
</div>


                                        <!-- ✅ زر الحذف مع ID المستخدم -->
                                        <div class="open-delete-modal"
                                             data-user-id="@pair.item.Id"
                                             data-bs-toggle="modal"
                                             data-bs-target="#exampleModal"
                                             style="background-color: #ffebee; padding: 8px; border-radius: 50%;">
                                            <i class="fas fa-trash-alt" style="color: #d32f2f; cursor: pointer;"></i>
                                        </div>
                                            <a style="background-color: #e3f2fd; padding: 8px; border-radius: 50%;" asp-action="handelRols" asp-controller="AllUserController1" asp-route-id="@pair.item.Id"><i class="bi bi-shield-lock" style="color: #1976d2; cursor: pointer;"></i> </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>
    </div>

<!-- ✅ مودال الحذف -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="deleteUserModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this user? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post">
                    <input type="hidden" id="userIdToDelete" />
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- ✅ Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="editUserForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">Edit User Information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <input type="hidden" id="editUserId" name="Id" />

                    <div class="col-md-6">
                        <label for="editFirstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="editFirstName" name="FirstName" />
                    </div>

                    <div class="col-md-6">
                        <label for="editLastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="editLastName" name="LastName" />
                    </div>

                    <div class="col-md-12">
                        <label for="editAddress" class="form-label">Address</label>
                        <input type="text" class="form-control" id="editAddress" name="Address" />
                    </div>

                    <div class="col-md-12">
                        <label for="editEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="editEmail" name="Email" />
                    </div>

                    <div class="col-md-12">
                        <label for="editPhoneNumber" class="form-label">Phone Number</label>
                        <input type="text" class="form-control" id="editPhoneNumber" name="PhoneNumber" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- ✅ JavaScript -->
<script>
    $(document).ready(function () {
           var table = $('#productTable').DataTable({
        pageLength: 10,
        lengthMenu: [5, 10, 25, 50, 100],
        ordering: true,
        searching: true,
        info: true,

        // ✅ ترتيب: dropdown (lengthMenu) + بحث + كبسات فوق
        dom:
            "<'row mb-3 align-items-center'<'col-md-3 d-flex justify-content-start'l><'col-md-5 d-flex justify-content-center'f><'col-md-4 d-flex justify-content-end'B>>" +
            "<'row'<'col-12'tr>>" +
            "<'row mt-3'<'col-md-6'i><'col-md-6 d-flex justify-content-end'p>>",

        buttons: [
            {
                extend: 'copyHtml5',
                text: '<i class="bi bi-clipboard"></i> COPY',
                className: 'btn btn-outline-primary btn-sm rounded-pill fw-semibold'
            },
            {
                extend: 'excelHtml5',
                text: '<i class="bi bi-file-earmark-excel"></i> EXCEL',
                className: 'btn btn-outline-success btn-sm rounded-pill fw-semibold'
            },
            {
                extend: 'pdfHtml5',
                text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                className: 'btn btn-outline-danger btn-sm rounded-pill fw-semibold',
                orientation: 'landscape',
                pageSize: 'A4'
            },
            {
                extend: 'print',
                text: '<i class="bi bi-printer"></i> PRINT',
                className: 'btn btn-outline-dark btn-sm rounded-pill fw-semibold'
            }
        ],
        language: {
            search: "",
            searchPlaceholder: "🔎 Search products...",
            lengthMenu: "Show _MENU_",   // 👈 هذا اللي بظهر dropdown
            info: "Showing _START_ to _END_ of _TOTAL_ products",
            paginate: {
                previous: "← Prev",
                next: "Next →"
            }
        }
    });

    // ✅ خلي البحث يتمدد
    $('#productTable_filter').parent().addClass('flex-grow-1');
    $('#productTable_filter').addClass('w-100 d-flex');
    $('#productTable_filter label').addClass('w-100 d-flex');
    $('#productTable_filter input')
        .addClass('form-control shadow-sm px-4 py-2 rounded-pill w-100')
        .attr("placeholder", "🔎  Type product name, category, or code...");


    // ✅ تنسيق الـ Dropdown
    $('#productTable_length select')
        .addClass('form-select form-select-sm rounded-pill shadow-sm')
        .css({ 'width': '80px', 'display': 'inline-block' });
        // ✅ مسافة بين الكبسات
    $('.dt-buttons .btn').css({
        'margin-left': '0.4rem',
        'margin-right': '0.4rem'
    });


        function showAlert(message, type = 'success') {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            $('#alertPlaceholder').html(alertHtml);

            setTimeout(() => {
                $('.alert').alert('close');
            }, 4000);
        }

        // ✅ حذف
        $('.open-delete-modal').on('click', function () {
            var userId = $(this).data('user-id');
            $('#userIdToDelete').val(userId);
        });

        $('#confirmDeleteBtn').on('click', function (e) {
            e.preventDefault();

            var userId = $('#userIdToDelete').val();

            $.ajax({
                url: '@Url.Action("Deleted", "AllUserController1")',
                type: 'POST',
                data: { Id: userId },
                success: function (response) {
                    showAlert("User deleted successfully!", "success");
                    $('#exampleModal').modal('hide');
                    setTimeout(() => location.reload(), 1500);
                },
                error: function (xhr) {
                    showAlert("Error while deleting user: " + xhr.status, "danger");
                 
                }
            });
        });

        // ✅ تعديل
        $('.edit-user-btn').on('click', function () {
            var userId = $(this).data('user-id');

            $.ajax({
                url: '@Url.Action("GetUserById", "AllUserController1")',
                type: 'GET',
                data: { id: userId },
                success: function (user) {
                    $('#editUserId').val(user.id);
                    $('#editFirstName').val(user.firstName);
                    $('#editLastName').val(user.lastName);
                    $('#editAddress').val(user.address);
                    $('#editEmail').val(user.email);
                    $('#editPhoneNumber').val(user.phoneNumber);
                    console.log(user.phoneNumber);
                    $('#editUserModal').modal('show');
                },
                error: function (xhr) {
                    showAlert("Failed to fetch user data.", "danger");
                    console.log(xhr.responseText);
                }
            });
        });

        // ✅ إرسال التعديلات
        $('#editUserForm').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                url: '@Url.Action("EditUser", "AllUserController1")',
                type: 'POST',
                data: $(this).serialize(),
                success: function () {
                    showAlert("User deleted successfully!", "success");
                    $('#editUserModal').modal('hide');
                    setTimeout(() => location.reload(), 1500);
                },
                error: function (xhr) {
                    showAlert("Error while saving changes.", "danger");
                    console.log(xhr.responseText);
                }
            });
        });

    });
</script>


<script>
    const ctx = document.getElementById('myChart');

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['', 'Number of Users', 'Confirmed', 'Unconfirmed', ''],
        datasets: [{
          label: 'Dataset',
          data: [0, @totalUsers, @confirmedUsers, @unconfirmedUsers, 0],
          borderColor: 'rgba(255, 99, 132, 1)',
          backgroundColor: 'rgba(255, 99, 132, 0.4)',
          fill: 'start',
          tension: 0.3,
          pointBackgroundColor: 'rgba(255, 99, 132, 1)',
          pointBorderColor: '#fff',
          pointRadius: 5,
          pointHoverRadius: 7,
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        animations: {
          x: {
            type: 'number',
            easing: 'easeInOutQuart',
            duration: 1000,
            delay: (ctx) => ctx.dataIndex * 300
          },
          y: {
            type: 'number',
            easing: 'easeInOutQuart',
            duration: 1000,
            delay: (ctx) => ctx.dataIndex * 300
          }
        },
        plugins: {
          title: {
            display: true,
            text: 'Fill: start',
          },
          legend: {
            labels: {
              color: '#000'
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });


</script>
<script>
  const ctx1 = document.getElementById('zaid');

new Chart(ctx1, {
