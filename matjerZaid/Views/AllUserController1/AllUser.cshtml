@model List<ECApp.Model.Data.AllUser>;
@using Microsoft.AspNetCore.Identity
@using StoreOn.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    Layout = "_Layoutsystem";
}
@{
    var appUser = await UserManager.GetUserAsync(User);
    var phoneNumber = appUser != null ? await UserManager.GetPhoneNumberAsync(appUser) : "No phone number";

    var totalUsers = Model.Count;
    var confirmedUsers = Model.Count(u => u.EmailConfirmed);
    var unconfirmedUsers = totalUsers - confirmedUsers;
   
}
<style>
    /* إلغاء أي خلفية أو ظل حوالين أزرار DataTables */
    div.dt-buttons {
        background: transparent !important;
        box-shadow: none !important;
        border: none !important;
        padding: 0 !important;
    }

    /* نفس الشي للزر نفسه */
    .dt-buttons .btn {
        background-color: transparent !important;
        box-shadow: none !important;
    }

</style>

