<div class=" my-2">
    <div class="p-5 bg-white shadow-lg rounded-4 border-start border-5 border-primary position-relative overflow-hidden">

        <!-- Subtle Icon Background -->
        <div class="position-absolute top-0 end-0 mt-4 me-4 opacity-10" style="font-size: 6rem;">
