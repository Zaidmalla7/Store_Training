@model List<matjerZaid.Models.Data.AllUser>;
@using Microsoft.AspNetCore.Identity
@using StoreOn.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var appUser = await UserManager.GetUserAsync(User);
    var phoneNumber = appUser != null ? await UserManager.GetPhoneNumberAsync(appUser) : "No phone number";

    var totalUsers = Model.Count;
    var confirmedUsers = Model.Count(u => u.EmailConfirmed);
    var unconfirmedUsers = totalUsers - confirmedUsers;
   
}

<!-- Bootstrap container to match your page style -->
<div class="container my-4">
    <div class="row align-items-stretch justify-content-around g-3">

        <!-- Admin Info Card -->
        <div class="col-md-4 col-lg-3">
            <div class="card  border-0 shadow  h-100">
                <div class="card-header badge badge-info rounded d-flex align-items-center ">
                    <i class="bi bi-person-badge-fill me-2 fs-5"></i>
                    <h6 class="">Admin Info</h6>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="d-flex flex-column gap-1 small">
                        <div><strong><i class="bi bi-person-fill me-2 text-info-emphasis"></i>Admin: </strong>@UserManager.GetUserName(User)</div>
                        <div><strong><i class="bi bi-fingerprint me-2 text-info-emphasis"></i>ID:</strong>@UserManager.GetUserId(User)</div>
                        <div><strong><i class="bi bi-telephone-fill me-2 text-info-emphasis"></i>Phone:</strong> @phoneNumber</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Page Title -->
        <div class="col-md-8 col-lg-8">
            <div class="card border-0 shadow h-100 ">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h2 class="fw-semibold mb-2 text-info-emphasis" style="font-size: 1.8rem;">
                        <i class="bi bi-people-fill me-2 text-info-emphasis"></i>
                        User Management Panel
                    </h2>
                    <p class="text-info-emphasis small mb-0">
                        Monitor users, roles, and confirmations in one place — clearly and easily.
                    </p>
                </div>
            </div>

        </div>

    </div>
</div>


    <div class="row m-3">
        <div class="col-lg-6">
        <div class="card shadow">
  <div class="card-body">
   <div>
  <canvas id="myChart"></canvas>
</div>
  </div>
</div>
        </div>
        <div class="col-lg-6">
        <div class="card shadow">
  <div class="card-body">
   <div>
  <canvas id="zaid"></canvas>
</div>
  </div>
</div>
        </div>
    </div>

    <div class="m-4">
    <div class="card shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <strong>Total Users:</strong> @totalUsers <br />
                        <small class="text-success">Confirmed: @confirmedUsers</small> |
                        <small class="text-danger">Not Confirmed: @unconfirmedUsers</small>
                    </div>
                </div>
                <input type="text" id="firstNameSearch" class="form-control my-3" placeholder="Search by First Name">

                <!-- ✅ تنبيه من Bootstrap -->
<div id="alertPlaceholder" class="my-3"></div>
            <div class="table-responsive-sm table-responsive-md" style="max-height: 700px; overflow-y: auto;">
                <table  class="table  table-responsive table-hover table-striped table-sm table-centered mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Address</th>
                            <th>Email</th>
                            <th>Email Confirmed</th>
                            <th>Phone Number</th>
                            <th>Created At</th>
                              <th>Roles</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pair in Model.Select((item, index) => new { item, index }))
                        {
                            <tr>
                                <td>@(pair.index + 1)</td>
                                <td>@pair.item.FirstName</td>
                                <td>@pair.item.LastName</td>
                                <td>@pair.item.Address</td>
                                <td>@pair.item.Email</td>
                                <td>
                                    <span class="badge @(pair.item.EmailConfirmed ? "badge-success rounded-pill d-inline" : "badge-danger rounded-pill d-inline")">
                                        @(pair.item.EmailConfirmed ? "Confirmed" : "Not Confirmed")
                                    </span>
                                </td>
                                <td>@pair.item.PhoneNumber</td>
                                <td>@pair.item.CreateAt</td>
                                <td>
                                     <span class="badge rounded-pill d-inline 
        @(pair.item.RolsName == "Admin" ? "badge-danger" : 
          pair.item.RolsName == "Sales" ? "badge-primary" : 
          pair.item.RolsName == "Client" ? "badge-success" : "badge-secondary")">
        @pair.item.RolsName
    </span>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 10px;">
                                       <div class="edit-user-btn"
     data-user-id="@pair.item.Id"
     style="background-color: #e3f2fd; padding: 8px; border-radius: 50%;"
     data-bs-toggle="modal"
     data-bs-target="#editUserModal">
    <i class="fas fa-edit" style="color: #1976d2; cursor: pointer;"></i>
</div>


                                        <!-- ✅ زر الحذف مع ID المستخدم -->
                                        <div class="open-delete-modal"
                                             data-user-id="@pair.item.Id"
                                             data-bs-toggle="modal"
                                             data-bs-target="#exampleModal"
                                             style="background-color: #ffebee; padding: 8px; border-radius: 50%;">
                                            <i class="fas fa-trash-alt" style="color: #d32f2f; cursor: pointer;"></i>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>
    </div>


<!-- ✅ مودال الحذف -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="deleteUserModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this user? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post">
                    <input type="hidden" id="userIdToDelete" />
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!-- ✅ Edit User Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="editUserForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editUserModalLabel">Edit User Information</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body row g-3">
                    <input type="hidden" id="editUserId" name="Id" />

                    <div class="col-md-6">
                        <label for="editFirstName" class="form-label">First Name</label>
                        <input type="text" class="form-control" id="editFirstName" name="FirstName" />
                    </div>

                    <div class="col-md-6">
                        <label for="editLastName" class="form-label">Last Name</label>
                        <input type="text" class="form-control" id="editLastName" name="LastName" />
                    </div>

                    <div class="col-md-12">
                        <label for="editAddress" class="form-label">Address</label>
                        <input type="text" class="form-control" id="editAddress" name="Address" />
                    </div>

                    <div class="col-md-12">
                        <label for="editEmail" class="form-label">Email</label>
                        <input type="email" class="form-control" id="editEmail" name="Email" />
                    </div>

                    <div class="col-md-12">
                        <label for="editPhoneNumber" class="form-label">Phone Number</label>
                        <input type="text" class="form-control" id="editPhoneNumber" name="PhoneNumber" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- ✅ JavaScript -->
<script>
    $(document).ready(function () {

        function showAlert(message, type = 'success') {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            $('#alertPlaceholder').html(alertHtml);

            setTimeout(() => {
                $('.alert').alert('close');
            }, 4000);
        }

        // ✅ حذف
        $('.open-delete-modal').on('click', function () {
            var userId = $(this).data('user-id');
            $('#userIdToDelete').val(userId);
        });

        $('#confirmDeleteBtn').on('click', function (e) {
            e.preventDefault();

            var userId = $('#userIdToDelete').val();

            $.ajax({
                url: '@Url.Action("Deleted", "AllUserController1")',
                type: 'POST',
                data: { Id: userId },
                success: function (response) {
                    showAlert("User deleted successfully!", "success");
                    $('#exampleModal').modal('hide');
                    setTimeout(() => location.reload(), 1500);
                },
                error: function (xhr) {
                    showAlert("Error while deleting user: " + xhr.status, "danger");
                 
                }
            });
        });

        // ✅ تعديل
        $('.edit-user-btn').on('click', function () {
            var userId = $(this).data('user-id');

            $.ajax({
                url: '@Url.Action("GetUserById", "AllUserController1")',
                type: 'GET',
                data: { id: userId },
                success: function (user) {
                    $('#editUserId').val(user.id);
                    $('#editFirstName').val(user.firstName);
                    $('#editLastName').val(user.lastName);
                    $('#editAddress').val(user.address);
                    $('#editEmail').val(user.email);
                    $('#editPhoneNumber').val(user.phoneNumber);

                    $('#editUserModal').modal('show');
                },
                error: function (xhr) {
                    showAlert("Failed to fetch user data.", "danger");
                    console.log(xhr.responseText);
                }
            });
        });

        // ✅ إرسال التعديلات
        $('#editUserForm').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                url: '@Url.Action("EditUser", "AllUserController1")',
                type: 'POST',
                data: $(this).serialize(),
                success: function () {
                    showAlert("User deleted successfully!", "success");
                    $('#editUserModal').modal('hide');
                    setTimeout(() => location.reload(), 1500);
                },
                error: function (xhr) {
                    showAlert("Error while saving changes.", "danger");
                    console.log(xhr.responseText);
                }
            });
        });

    });

</script>
<script>
    $(document).ready(function () {

        $("#firstNameSearch").on("keyup", function () {
            var value = $(this).val().toLowerCase();

            $("table tbody tr").filter(function () {
                var firstName = $(this).find("td:eq(1)").text().toLowerCase(); // First Name is column index 1
                $(this).toggle(firstName.indexOf(value) > -1);
            });
        });

    });
</script>

<script>
    const ctx = document.getElementById('myChart');

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['', 'Number of Users', 'Confirmed', 'Unconfirmed', ''],
        datasets: [{
          label: 'Dataset',
          data: [0, @totalUsers, @confirmedUsers, @unconfirmedUsers, 0],
          borderColor: 'rgba(255, 99, 132, 1)',
          backgroundColor: 'rgba(255, 99, 132, 0.4)',
          fill: 'start',
          tension: 0.3,
          pointBackgroundColor: 'rgba(255, 99, 132, 1)',
          pointBorderColor: '#fff',
          pointRadius: 5,
          pointHoverRadius: 7,
          borderWidth: 2
        }]
      },
      options: {
        responsive: true,
        animations: {
          x: {
            type: 'number',
            easing: 'easeInOutQuart',
            duration: 1000,
            delay: (ctx) => ctx.dataIndex * 300
          },
          y: {
            type: 'number',
            easing: 'easeInOutQuart',
            duration: 1000,
            delay: (ctx) => ctx.dataIndex * 300
          }
        },
        plugins: {
          title: {
            display: true,
            text: 'Fill: start',
          },
          legend: {
            labels: {
              color: '#000'
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });


</script>
