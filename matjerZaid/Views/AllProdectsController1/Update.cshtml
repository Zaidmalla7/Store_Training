            }

            error.textContent = ""; // في حال كان في بيانات، نظف الرسالة
            return true;
        }
    </script>
    -->
</body>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
</html>

