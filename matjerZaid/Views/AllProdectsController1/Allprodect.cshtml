<!--table podect-->
<div class="mb-4" id="2">
    <div class="card shadow">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <!-- Total Products -->
    <div class="d-flex align-items-center gap-3">
        <div class="bg-white rounded-circle d-flex justify-content-center align-items-center shadow-sm" style="width: 50px; height: 50px;">
            <i class="bi bi-box-seam-fill fs-4 text-info"></i>
        </div>
        <div>
            <div class="text-muted small">Total Products</div>
            <div class="fs-4 fw-semibold text-dark">@allprodect</div>
        </div>
    </div>
                <div>
                    <a class="btn btn-success shadow-sm" asp-action="Addprodect" asp-controller="AllProdectsController1">
                        <i class="bi bi-plus-circle me-1"></i> Add New Product
                    </a>
                </div>
            </div>
           

            <!--  تنبيه من Bootstrap -->
            <div id="alertPlaceholder" class="my-3"></div>
            <div class="table-responsive-sm table-responsive-md " style="">
                    <table id="productTable" class="table  table-responsive table-hover table-striped table-sm table-centered mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Code-Product</th>
                            <th>Imge</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Price</th>
                            <th>DiscountPrice</th>
                            <th>Stock</th>
                            <th>UpdatedAt</th>
                            <th>Created At</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pro in Model.Select((item, index) => new { item, index }))
                        {
                         
                         <tr>
                             <td>@(pro.index+1)</td>
                             <td>@(pro.item.Name)</td>
                             <td>@(pro.item.Description.Length >= 10 ? pro.item.Description.Substring(0,10) + "..." : pro.item.Description)</td>
                             <td>@(pro.item.Sku)</td>
                                <td>
                                    <img src="@pro.item.ImageUrl" width="50" height="50" alt="صورة المنتج" />
                                </td>
                             <td>@(pro.item.CategoryName)</td>
                             <td>
                                    <span class="badge rounded-pill d-inline @(pro.item.StatusName == "Active" ? "badge-success" : pro.item.StatusName == "Inactive" ? "badge-danger":"badge-secondary")">@pro.item.StatusName</span>
                             </td>
                             <td>@(((double)pro.item.Price).ToString("0.00"))</td>
                                <td>@($"{pro.item.DiscountPrice ?? 0:0.00}%")</td>
                                <td> <span class="badge rounded-pill d-inline @(pro.item.Stock != null ? "badge-success" : "badge-danger")">@(pro.item.Stock  != null ? "Available (" + (pro.item.Stock) + ")" : "Not Availabl") </span> </td>
                                <td>
                                    @if (pro.item.UpdatedAt != null)
                                    {
                                        @pro.item.UpdatedAt
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger rounded-pill d-inline">Not Available</span>
                                    }
                                </td>
                                <td>@(pro.item.CreatedAt.ToString())</td>
                                <td>
                                    <div style="display: flex; gap: 10px;">
                                        <div style="background-color: #e3f2fd; padding: 8px; border-radius: 50%;">
                                            <a asp-action="Update" asp-controller="AllProdectsController1" asp-route-ProductId="@pro.item.ProductId">
                                            <i class="fas fa-edit" style="color: #1976d2; cursor: pointer;"></i>
                                            </a>
                                        </div>


                                        <!-- ✅ زر الحذف مع ID المستخدم -->
                                        <div class="open-delete-modal"
                                             data-user-id="@pro.item.ProductId"
                                             data-bs-toggle="modal"
                                             data-bs-target="#exampleModal"
                                             style="background-color: #ffebee; padding: 8px; border-radius: 50%;">
                                            <i class="fas fa-trash-alt" style="color: #d32f2f; cursor: pointer;"></i>
                                        </div>
                                    </div>
                                </td>
                         </tr>
                     }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>

<!-- ✅ مودال الحذف -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="deleteUserModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this user? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post">
                    <input type="hidden" id="userIdToDelete"  />
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!--كود الجافا-->
<script>
    $(document).ready(function () {
     var table = $('#productTable').DataTable({
        pageLength: 10,
        lengthMenu: [5, 10, 25, 50, 100],
        ordering: true,
        searching: true,
        info: true,

        // ✅ ترتيب: dropdown (lengthMenu) + بحث + كبسات فوق
        dom:
            "<'row mb-3 align-items-center'<'col-md-3 d-flex justify-content-start'l><'col-md-5 d-flex justify-content-center'f><'col-md-4 d-flex justify-content-end'B>>" +
            "<'row'<'col-12'tr>>" +
            "<'row mt-3'<'col-md-6'i><'col-md-6 d-flex justify-content-end'p>>",

        buttons: [
            {
                extend: 'copyHtml5',
                text: '<i class="bi bi-clipboard"></i> COPY',
                className: 'btn btn-outline-primary btn-sm rounded-pill fw-semibold'
            },
            {
                extend: 'excelHtml5',
                text: '<i class="bi bi-file-earmark-excel"></i> EXCEL',
                className: 'btn btn-outline-success btn-sm rounded-pill fw-semibold'
            },
            {
                extend: 'pdfHtml5',
                text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                className: 'btn btn-outline-danger btn-sm rounded-pill fw-semibold',
                orientation: 'landscape',
                pageSize: 'A4'
            },
            {
                extend: 'print',
                text: '<i class="bi bi-printer"></i> PRINT',
                className: 'btn btn-outline-dark btn-sm rounded-pill fw-semibold'
            }
        ],
        language: {
            search: "",
            searchPlaceholder: "🔎 Search products...",
            lengthMenu: "Show _MENU_",   // 👈 هذا اللي بظهر dropdown
            info: "Showing _START_ to _END_ of _TOTAL_ products",
            paginate: {
                previous: "← Prev",
                next: "Next →"
            }
        }
    });

    // ✅ خلي البحث يتمدد
    $('#productTable_filter').parent().addClass('flex-grow-1');
    $('#productTable_filter').addClass('w-100 d-flex');
    $('#productTable_filter label').addClass('w-100 d-flex');
    $('#productTable_filter input')
        .addClass('form-control shadow-sm px-4 py-2 rounded-pill w-100')
        .attr("placeholder", "🔎  Type product name, category, or code...");


    // ✅ تنسيق الـ Dropdown
    $('#productTable_length select')
        .addClass('form-select form-select-sm rounded-pill shadow-sm')
        .css({ 'width': '80px', 'display': 'inline-block' });
        // ✅ مسافة بين الكبسات
    $('.dt-buttons .btn').css({
        'margin-left': '0.4rem',
        'margin-right': '0.4rem'
    });





        function showAlert(message, type = 'success') {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            $('#alertPlaceholder').html(alertHtml);

            setTimeout(() => {
                $('.alert').alert('close');
            }, 4000);
        }

        // ✅ حذف
        $('.open-delete-modal').on('click', function () {
            var userId = $(this).data('user-id');
            $('#userIdToDelete').val(userId);
        });

        $('#confirmDeleteBtn').on('click', function (e) {
            e.preventDefault();

            var userId = $('#userIdToDelete').val();
            $.ajax({
        url: '@Url.Action("Delet", "AllProdectsController1")',
        type: 'POST',
        data: { Id: userId },
        success: function (response) {
            showAlert("Product deleted successfully!", "success");
            $('#exampleModal').modal('hide');
            setTimeout(() => location.reload(), 1500);
        },
        error: function (xhr) {
            showAlert("Error while deleting user: " + xhr.status, "danger");
        }
    });
        });

        // ✅ تعديل
        $('.edit-user-btn').on('click', function () {
            var userId = $(this).data('user-id');

            $.ajax({
                url: '@Url.Action("GetUserById", "AllUserController1")',
                type: 'GET',
                data: { id: userId },
                success: function (user) {
                    $('#editUserId').val(user.id);
                    $('#editFirstName').val(user.firstName);
                    $('#editLastName').val(user.lastName);
                    $('#editAddress').val(user.address);
                    $('#editEmail').val(user.email);
                    $('#editPhoneNumber').val(user.phoneNumber);

                    $('#editUserModal').modal('show');
                },
                error: function (xhr) {
                    showAlert("Failed to fetch user data.", "danger");
                    console.log(xhr.responseText);
                }
            });
        });

        // ✅ إرسال التعديلات
        $('#editUserForm').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                url: '@Url.Action("EditUser", "AllUserController1")',
                type: 'POST',
                data: $(this).serialize(),
                success: function () {
                    showAlert("User deleted successfully!", "success");
                    $('#editUserModal').modal('hide');
                    setTimeout(() => location.reload(), 1500);
                },
                error: function (xhr) {
                    showAlert("Error while saving changes.", "danger");
                    console.log(xhr.responseText);
                }
            });
        });

    });
</script>
<script>
    function showAlert(message, type) {
        const alertPlaceholder = document.getElementById('alertPlaceholder');
        const wrapper = document.createElement('div');
        wrapper.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        alertPlaceholder.innerHTML = ''; // احذف أي تنبيه قديم
        alertPlaceholder.append(wrapper);
    }
</script>
