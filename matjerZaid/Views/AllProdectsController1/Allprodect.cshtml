            'rgba(255, 99, 132, 0.2)',  // January
            'rgba(255, 159, 64, 0.2)',  // February
            'rgba(255, 205, 86, 0.2)',  // March
            'rgba(75, 192, 192, 0.2)',  // April
            'rgba(54, 162, 235, 0.2)',  // May
            'rgba(153, 102, 255, 0.2)', // June
            'rgba(201, 203, 207, 0.2)'  // July
          ],
          borderColor: [
            'rgb(255, 99, 132)',
            'rgb(255, 159, 64)',
            'rgb(255, 205, 86)',
            'rgb(75, 192, 192)',
