@{
}
@using Microsoft.AspNetCore.Identity
@using StoreOn.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model List<matjerZaid.Models.Data.Podects>;

@{
    var appUser = await UserManager.GetUserAsync(User);
    var phoneNumber = appUser != null ? await UserManager.GetPhoneNumberAsync(appUser) : "No phone number";
    var allprodect = Model.Count();
}
<!-- Bootstrap container to match your page style -->
<div class="container my-4">
    <div class="row align-items-stretch justify-content-around g-3">

        <!-- Admin Info Card -->
        <div class="col-md-4 col-lg-3">
            <div class="card  border-0 shadow  h-100">
                <div class="card-header badge badge-info rounded d-flex align-items-center ">
                    <i class="bi bi-person-badge-fill me-2 fs-5"></i>
                    <h6 class="">Admin Info</h6>
                </div>
                <div class="card-body py-2 px-3">
                    <div class="d-flex flex-column gap-1 small">
                        <div><strong><i class="bi bi-person-fill me-2 text-info-emphasis"></i>Admin: </strong>@UserManager.GetUserName(User)</div>
                        <div><strong><i class="bi bi-fingerprint me-2 text-info-emphasis"></i>ID:</strong>@UserManager.GetUserId(User)</div>
                        <div><strong><i class="bi bi-telephone-fill me-2 text-info-emphasis"></i>Phone:</strong> @phoneNumber</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Page Title -->
        <div class="col-md-8 col-lg-8">
            <div class="card border-0 shadow h-100 ">
                <div class="card-body d-flex flex-column justify-content-center text-center">
                    <h2 class="fw-semibold mb-2 text-info-emphasis" style="font-size: 1.8rem;">
                        🛒 Product Management Panel
                    </h2>
                    <p class="text-info-emphasis small mb-0">
                        Easily monitor products, categories, and pricing — all in one place
                    </p>
                </div>
            </div>

        </div>

    </div>
</div>
<!--كود الرسم البياني-->
<div class="row m-3">
    <div class="col-lg-4 mb-2">
        <div class="card shadow">
            <div class="card-body">
                <div style="height: 400px;">
                    <canvas  id="myChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4 mb-2">
        <div class="card shadow">
            <div class="card-body">
                <div style="height: 400px;">
                    <canvas id="myRadarChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow">
            <div class="card-body">
                <div style="height: 400px;">
                    <canvas id="zaid"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
<!--table podect-->
<div class="m-4">
    <div class="card shadow">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <!-- Total Products -->
    <div class="d-flex align-items-center gap-3">
        <div class="bg-white rounded-circle d-flex justify-content-center align-items-center shadow-sm" style="width: 50px; height: 50px;">
            <i class="bi bi-box-seam-fill fs-4 text-info"></i>
        </div>
        <div>
            <div class="text-muted small">Total Products</div>
            <div class="fs-4 fw-semibold text-dark">@allprodect</div>
        </div>
    </div>
                <div>
                    <a class="btn btn-success shadow-sm" asp-action="Addprodect" asp-controller="AllProdectsController1">
                        <i class="bi bi-plus-circle me-1"></i> Add New Product
                    </a>
                </div>
            </div>

            <input type="text" id="firstNameSearch" class="form-control rounded-1 shadow-sm my-3" placeholder="Search by Code-Product">

            <!--  تنبيه من Bootstrap -->
            <div id="alertPlaceholder" class="my-3"></div>
            <div class="table-responsive-sm table-responsive-md " style="max-height: 700px; overflow-y: auto;">
                <table class="table  table-responsive table-hover table-striped table-sm table-centered mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Code-Product</th>
                            <th>Imge</th>
                            <th>Category</th>
                            <th>Status</th>
                            <th>Price</th>
                            <th>DiscountPrice</th>
                            <th>Stock</th>
                            <th>UpdatedAt</th>
                            <th>Created At</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pro in Model.Select((item, index) => new { item, index }))
                        {
                         
                         <tr>
                             <td>@(pro.index+1)</td>
                             <td>@(pro.item.Name)</td>
                             <td>@(pro.item.Description.Length >= 10 ? pro.item.Description.Substring(0,10) + "..." : pro.item.Description)</td>
                             <td>@(pro.item.Sku)</td>
                                <td>
                                    <img src="@pro.item.ImageUrl" width="50" height="50" alt="صورة المنتج" />
                                </td>
                             <td>@(pro.item.CategoryName)</td>
                             <td>
                                    <span class="badge rounded-pill d-inline @(pro.item.StatusName == "Active" ? "badge-success" : pro.item.StatusName == "Inactive" ? "badge-danger":"badge-secondary")">@pro.item.StatusName</span>
                             </td>
                             <td>@(((double)pro.item.Price).ToString("0.00"))</td>
                                <td>@($"{pro.item.DiscountPrice ?? 0:0.00}%")</td>
                                <td> <span class="badge rounded-pill d-inline @(pro.item.Stock != null ? "badge-success" : "badge-danger")">@(pro.item.Stock  != null ? "Available (" + (pro.item.Stock) + ")" : "Not Availabl") </span> </td>
                                <td>
                                    @if (pro.item.UpdatedAt != null)
                                    {
                                        @pro.item.UpdatedAt
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger rounded-pill d-inline">Not Available</span>
                                    }
                                </td>
                                <td>@(pro.item.CreatedAt.ToString())</td>
                                <td>
                                    <div style="display: flex; gap: 10px;">
                                        <div style="background-color: #e3f2fd; padding: 8px; border-radius: 50%;">
                                            <a asp-action="Update" asp-controller="AllProdectsController1" asp-route-ProductId="@pro.item.ProductId">
                                            <i class="fas fa-edit" style="color: #1976d2; cursor: pointer;"></i>
                                            </a>
                                        </div>


                                        <!-- ✅ زر الحذف مع ID المستخدم -->
                                        <div class="open-delete-modal"
                                             data-user-id="@pro.item.ProductId"
                                             data-bs-toggle="modal"
                                             data-bs-target="#exampleModal"
                                             style="background-color: #ffebee; padding: 8px; border-radius: 50%;">
                                            <i class="fas fa-trash-alt" style="color: #d32f2f; cursor: pointer;"></i>
                                        </div>
                                    </div>
                                </td>
                         </tr>
                     }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- ✅ مودال الحذف -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger" id="deleteUserModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this user? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post">
                    <input type="hidden" id="userIdToDelete"  />
                    <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>
<!--كود الجافا-->
<script>
    $(document).ready(function () {

        function showAlert(message, type = 'success') {
            const alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            $('#alertPlaceholder').html(alertHtml);

            setTimeout(() => {
                $('.alert').alert('close');
            }, 4000);
        }

        // ✅ حذف
        $('.open-delete-modal').on('click', function () {
            var userId = $(this).data('user-id');
            $('#userIdToDelete').val(userId);
        });

        $('#confirmDeleteBtn').on('click', function (e) {
            e.preventDefault();

            var userId = $('#userIdToDelete').val();
            $.ajax({
        url: '@Url.Action("Zaid", "AllProdectsController1")',
        type: 'POST',
        data: { Id: userId },
        success: function (response) {
            showAlert("User deleted successfully!", "success");
            $('#exampleModal').modal('hide');
            setTimeout(() => location.reload(), 1500);
        },
        error: function (xhr) {
            showAlert("Error while deleting user: " + xhr.status, "danger");
        }
    });
        });

        // ✅ تعديل
        $('.edit-user-btn').on('click', function () {
            var userId = $(this).data('user-id');

            $.ajax({
                url: '@Url.Action("GetUserById", "AllUserController1")',
                type: 'GET',
                data: { id: userId },
                success: function (user) {
                    $('#editUserId').val(user.id);
                    $('#editFirstName').val(user.firstName);
                    $('#editLastName').val(user.lastName);
                    $('#editAddress').val(user.address);
                    $('#editEmail').val(user.email);
                    $('#editPhoneNumber').val(user.phoneNumber);

                    $('#editUserModal').modal('show');
                },
                error: function (xhr) {
                    showAlert("Failed to fetch user data.", "danger");
                    console.log(xhr.responseText);
                }
            });
        });

        // ✅ إرسال التعديلات
        $('#editUserForm').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                url: '@Url.Action("EditUser", "AllUserController1")',
                type: 'POST',
                data: $(this).serialize(),
                success: function () {
                    showAlert("User deleted successfully!", "success");
                    $('#editUserModal').modal('hide');
                    setTimeout(() => location.reload(), 1500);
                },
                error: function (xhr) {
                    showAlert("Error while saving changes.", "danger");
                    console.log(xhr.responseText);
                }
            });
        });

    });
</script>
<script>
    function showAlert(message, type) {
        const alertPlaceholder = document.getElementById('alertPlaceholder');
        const wrapper = document.createElement('div');
        wrapper.innerHTML = `
            <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        `;
        alertPlaceholder.innerHTML = ''; // احذف أي تنبيه قديم
        alertPlaceholder.append(wrapper);
    }
</script>
<!--كود الرسم البياني-->
<script>
       const ctx = document.getElementById('myChart');

    new Chart(ctx, {
      type: 'line',
      data: {
        labels: ['', 'Number of Users', 'Confirmed', 'Unconfirmed', ''],
        datasets: [{
          label: 'Dataset',
          data: [0, 3, 5, 5, 0],
          borderColor: 'rgba(255, 99, 132, 1)',
          backgroundColor: 'rgba(255, 99, 132, 0.4)',
          fill: 'start',
          tension: 0.3,
          pointBackgroundColor: 'rgba(255, 99, 132, 1)',
          pointBorderColor: '#fff',
          pointRadius: 5,
          pointHoverRadius: 7,
          borderWidth: 2
        }]
      },
      options: {
          responsive: true,
    maintainAspectRatio: false,

        animations: {
          x: {
            type: 'number',
            easing: 'easeInOutQuart',
            duration: 1000,
            delay: (ctx) => ctx.dataIndex * 300
          },
          y: {
            type: 'number',
            easing: 'easeInOutQuart',
            duration: 1000,
            delay: (ctx) => ctx.dataIndex * 300
          }
        },
        plugins: {
          title: {
            display: true,
            text: 'Fill: start',
          },
          legend: {
            labels: {
              color: '#000'
            }
          }
        },
        scales: {
          y: {
            beginAtZero: true
          }
        }
      }
    });

</script>
