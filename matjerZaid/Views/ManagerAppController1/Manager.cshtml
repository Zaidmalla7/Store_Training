    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@using Microsoft.AspNetCore.Identity
@using StoreOn.Models



@inject  SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title></title>
      <style>
          .point .card{
              cursor:pointer;
          }
      </style>
</head>
<body>
    @{
    var appUser = await UserManager.GetUserAsync(User); // جلب المستخدم الفعلي
    var phoneNumber = appUser != null ? await UserManager.GetPhoneNumberAsync(appUser) : "No phone number";
}
<div class="container">
    <h2 class="text-center">Management system</h2
        <div class="modal text-center" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content badge badge-primary rounded">

    <div class="p-2 text-start">
       <p> <i class="fa-solid fa-user"></i>  Admin : @UserManager.GetUserName(User) . </p>
       <p> <i class="fa-regular fa-id-card"></i>  ID Admin : @UserManager.GetUserId(User) . </p>
       <p> <i class="fa-solid fa-phone"></i> Phone Admin : @phoneNumber</p>
    </div>
    </div>
    
  </div>
  </div>
  <div class="container">
      <div class="point row mt-3">
        
        <div class="col-lg-3 col-md-6 col-sm-12">
           <a asp-action="Allprodect" asp-controller="AllProdectsController1">
            <div class="card">
    <div class="card-body d-flex justify-content-between align-items-center">
      <!-- معلومات المنتجات -->
      <div>
          <h5>Product management</h5>
        <h4 class="mb-1">3,215</h4>
        <p class="text-muted mb-1">Products</p>
        <p class="text-success small mb-0">
          <i class="bi bi-arrow-up"></i> 3.2% since last week
        </p>
      </div>

      <!-- أيقونة المنتجات -->
      <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
        <i class="bi bi-box-seam fs-4"></i>
      </div>
    </div>
  </div>
  </a>

        </div>
           <div class="col-lg-3 col-md-6 col-sm-12">
               
  <div class="card ">
    <div class="card-body d-flex justify-content-between align-items-center">
      <div>
           <h5>Order management</h5>
        <h4 class="mb-1">5,643</h4>
        <p class="text-muted mb-1">Orders</p>
        <p class="text-danger small mb-0">
          <i class="bi bi-arrow-down"></i> 0.82% since last week
        </p>
      </div>
      <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
        <i class="bi bi-cart-fill fs-4"></i>
      </div>
    </div>
  </div>
        </div>
        <div class="col-lg-3 col-md-6 col-sm-12">
            <a asp-action="AllUser" asp-controller="AllUserController1">
            <div class="card">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
         <h5>User management</h5>
      <h4 class="mb-1">12,430</h4>
      <p class="text-muted mb-1">Users</p>
      <p class="text-success small mb-0">
        <i class="bi bi-arrow-up"></i> 1.25% since last week
      </p>
    </div>
    <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
      <i class="bi bi-people-fill fs-4"></i>
    </div>
  </div>
</div>
</a>
        </div>
        <div class="col-lg-3 col-md-6 col-sm-12">
            <div class="card shadow-sm" style="max-width: 340px;">
  <div class="card-body d-flex justify-content-between align-items-center">
    <div>
         <h5>Inventory management</h5>
      <h4 class="mb-1">3,275</h4>
      <p class="text-muted mb-1">Inventory</p>
      <p class="text-warning small mb-0">
        <i class="bi bi-arrow-down"></i> 0.45% since last week
      </p>
    </div>
    <div class="bg-warning bg-opacity-10 text-warning rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
      <i class="bi bi-box-seam fs-4"></i>
    </div>
  </div>
</div>

        </div>
      </div>
  </div>
   </div>
</body>
</html>