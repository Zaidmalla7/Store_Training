<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
       

        const swiper = new Swiper('.myProductSwiper', {
            slidesPerView: 1,
            spaceBetween: 20,
            loop: true,
            pagination: {
                el: '.swiper-pagination',
                clickable: true
            },
            navigation: {
                nextEl: '.swiper-button-next',
                prevEl: '.swiper-button-prev'
            },
            breakpoints: {
                576: { slidesPerView: 2 },
                768: { slidesPerView: 3 },
                992: { slidesPerView: 4 },
                1400: { slidesPerView: 5 }
            }
        });

        const lines = [
            "Stylish Interiors",
            "Modern Living Spaces",
            "Inspired by You",
            "Smart & Elegant Designs"
        ];
        let i = 0;
        const el = document.getElementById("dynamicHeroText");

        setInterval(() => {
            el.style.opacity = 0;
            setTimeout(() => {
                i = (i + 1) % lines.length;
                el.textContent = lines[i];
                el.style.opacity = 1;
            }, 500);
        }, 4000);
    });
        const continuousTestimonialsSwiper = new Swiper('.continuousTestimonialsSwiper', {
        slidesPerView: 1,
        spaceBetween: 20,
        loop: true,
        speed: 3000, 
        autoplay: {
            delay: 0, 
            disableOnInteraction: false, 
        },
        allowTouchMove: false, 
        breakpoints: {
            768: { slidesPerView: 2 },
            1200: { slidesPerView: 3 }
        }

    });


        var swiper = new Swiper(".categorySwiper", {
        loop: true,
        speed: 4000,          
        autoplay: {
            delay: 0,
            disableOnInteraction: false,
        },
        slidesPerView: 5,
        spaceBetween: 25,
        freeMode: true,
        freeModeMomentum: false,
        centeredSlides: false, 
        breakpoints: {
            0: {
                slidesPerView: 1.3,
            },
            576: {
                slidesPerView: 2.2,
            },
            768: {
                slidesPerView: 3.2,
            },
            1200: {
                slidesPerView: 4.5,
            }
        }
    });



     $(".add-to-cart").click(function () {
        var productId = $(this).data("id");

        $.ajax({
            url: '/CardController1/AddToCart',
            type: 'POST',
            data: { productId: productId, quantity: 1 },
            success: function (res) {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true,
                    background: res.success ? '#4CAF50' : '#F44336', // green or red
                    color: '#fff',
                    customClass: {
                        popup: 'colored-toast'
                    },
                    didOpen: (toast) => {
                        toast.onmouseenter = Swal.stopTimer;
                        toast.onmouseleave = Swal.resumeTimer;
                    }
                });

                if (res.success) {
                    Toast.fire({
                        icon: 'success',
                        title: res.message
                    });
                } else {
                    Toast.fire({
                        icon: 'error',
                        title: res.message
                    });
                }
            },
            error: function () {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true,
                    background: '#F44336', // red
                    color: '#fff'
                });

                Toast.fire({
                    icon: 'error',
                    title: 'Something went wrong. Please try again.'
                });
            }
        });
    });



    $(".add-to-wishlist").click(function () {
        var productId = $(this).data("id");

        $.ajax({
            url: '/WishlistController1/AddToWishlist',
            type: 'POST',
            data: { productId: productId },
            success: function (res) {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true,
                    background: res.success ? '#4CAF50' : '#F44336', // green or red
                    color: '#fff'
                });

                if (res.success) {
                    Toast.fire({
                        icon: 'success',
                        title: res.message
                    });
                } else {
                    Toast.fire({
                        icon: 'error',
                        title: res.message
                    });
                }
            },
            error: function () {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true,
                    background: '#F44336',
                    color: '#fff'
                });

                Toast.fire({
                    icon: 'error',
                    title: 'Network error, please try again.'
                });
            }
        });
    });


       
</script>
