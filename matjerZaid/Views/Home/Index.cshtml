<div class="mb-5">
    <h2 class="text-center fw-bold mb-5" style="font-size: 2.3rem;">
        Shop by <span class="text-primary">Category</span>
    </h2>

    <div class="swiper categorySwiper px-2">
        <div class="swiper-wrapper">
            @{
                var categories = new[] {
                        ("Health & Personal Care", "bi-heart-pulse", "gradient-health", 27),
                        ("Beauty & Makeup", "bi-brush", "gradient-beauty", 24),
                        ("Sports & Fitness", "bi-bicycle", "gradient-sports", 30),
                        ("Home & Kitchen", "bi-house-heart", "gradient-home", 22),
                        ("Electronics & Tech", "bi-laptop", "gradient-tech", 20),
                        ("Fashion & Apparel", "bi-bag-heart", "gradient-fashion", 30),
                        ("Books & Stationery", "bi-book", "gradient-books", 30),
                        ("Pet Supplies", "bi-bag-dash", "gradient-pets", 30),
                        ("Children", "bi-emoji-smile", "gradient-children", 30),
                        };
            }

            @foreach (var category in categories)
            {
                <div class="swiper-slide">
                    <div class="category-card text-center mb-4 mt-2 p-4 rounded-4 hover-card">
                        <div class="icon-circle mb-3 mx-auto @category.Item3">
                            <i class="@category.Item2"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-1">@category.Item1</h6>
                        <p class="text-muted small mb-0">@category.Item4 items</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>



<div class="ms-5 me-5  my-5">
    <h4 class="mb-4 fw-bold text-center" style="font-size: 2.3rem;">Best Rated</h4>
    <hr />
    <div class="swiper myProductSwiper">
        <div class="swiper-wrapper">
            @foreach (var product in Model.Take(10))
            {
                var ratingWidth = (3.6 / 5.0) * 100;
                <div class="swiper-slide">
                    <div class="card p-3 text-center product-card">
                        <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid product-image mb-3" />
                        <div class="card-body p-0">
                            <h6 class="fw-semibold mb-1">@product.Name</h6>
                            <p class="product-description">@product.Description</p>

                            <div class="d-flex justify-content-center align-items-center mb-2">
                                <div class="stars-outer position-relative">
                                    <div class="stars-inner" style="width: @ratingWidth%;">★★★★★</div>
                                </div>
                                <small class="text-muted ms-2">(4.0)</small>
                            </div>

                            <p class="mb-2 text-success small"><i class="fa-solid fa-check-circle me-1"></i> In Stock</p>

                            <p class="mb-3">
                                @if (product.DiscountPrice.HasValue && product.DiscountPrice.Value != 0)
                                {
                                    <span class="old-price">@product.Price.ToString("N2") JOD</span>
                                    <span class="new-price">@product.DiscountPrice.Value.ToString("N2") JOD</span>
                                }
                                else
                                {
                                    <span class="new-price">@product.Price.ToString("N2") JOD</span>
                                }
                            </p>

                            <div class="d-flex gap-2 mb-2">
                                <button class="btn btn-primary  flex-grow-1 add-to-cart" data-id="@product.ProductId">
                                    <i class="fa fa-cart-plus"></i> Add to Cart
                                </button>
                                <button class="btn wishlist-btn px-3 add-to-wishlist" data-id="@product.ProductId" title="Add to Wishlist">
                                    <i class="fa-regular fa-heart"></i>
                                </button>
                            </div>
                            <a asp-action="DitalsProduct" asp-controller="Home" asp-route-ProductId="@product.ProductId"
                               class="btn btn-outline-primary rounded d-flex align-items-center justify-content-center gap-2 px-3 py-2 shadow-sm"
                               style="transition: all 0.2s ease-in-out;">
                                <i class="fa-solid fa-eye"></i> View Details
                            </a>
                            <!-- SKU -->
                            <div class="mt-2">
                                <small class="text-muted">SKU: @product.Sku</small>
                            </div>
                        </div>
                    </div>
                </div>

            }
        </div>
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>
    </div>
</div>

