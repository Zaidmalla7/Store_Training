    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model ECApp.Model.Database.Product;
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
<style>
    .thumbs-container {
        max-width: 100%;
        white-space: nowrap;
    }

        /* شكل السكرول */
        .thumbs-container::-webkit-scrollbar {
            height: 8px;
        }

        .thumbs-container::-webkit-scrollbar-thumb {
            background: #ccc;
            border-radius: 4px;
        }

            .thumbs-container::-webkit-scrollbar-thumb:hover {
                background: #999;
            }

</style>

<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-3">
                <div class="position-relative text-center mb-4">
                    <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 fs-6 shadow">SALE</span>
                    <img id="mainImage" src="@Model.ProductImages.First().ImageUrl"
                         class="img-fluid rounded-4 shadow-sm" alt="Product">
                </div>
                <div class="thumbs-container d-flex gap-3 overflow-auto p-2">
                    @foreach (var img in Model.ProductImages)
                    {
                        <img src="@img.ImageUrl"
                             class="thumb rounded-3 shadow-sm"
                             alt="Thumb"
                             style="cursor:pointer; width:100px; height:100px; object-fit:cover;">
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow-sm p-4">
                <h1 class="fw-bold mb-3">@Model.Name</h1>
                <p class="text-muted">Code: <span class="fw-semibold">@Model.Sku</span></p>

                <div class="mb-3">
                    <span class="text-warning fs-5">★★★★★</span>
                    <span class="text-muted">(320 reviews)</span>
                </div>
                <div class="mb-4">
                    @if (Model.DiscountPrice.HasValue && Model.DiscountPrice.Value != 0)
                    {
                        <span class="fs-2 fw-bold text-primary">
                            $@Model.DiscountPrice.Value.ToString("N2")
                        </span>
                        <span class="text-decoration-line-through text-muted ms-2">
                            $@Model.Price.ToString("N2")
                        </span>
                        <span class="badge bg-success ms-2">SALE</span>
                    }
                    else
                    {
                        <span class="fs-2 fw-bold text-primary">
                            $@Model.Price.ToString("N2")
                        </span>
                    }
                </div>




                <p class="fs-5 text-secondary mb-4">
                    @Model.Description
                </p>

                <div class="d-flex gap-3 mb-4">
                    <button class="btn btn-lg flex-grow-1 text-white shadow-sm add-to-cart" data-id="@Model.ProductId"
                            style="background: linear-gradient(45deg, #007bff, #00c6ff);">
                        <i class="bi bi-cart-plus"></i> Add to Cart
                    </button>
                    <button class="btn btn-outline-dark btn-lg shadow-sm add-to-wishlist" data-id="@Model.ProductId">
                        <i class="bi bi-heart"></i>
                    </button>
                </div>

                <ul class="list-unstyled text-muted">
                    <li><i class="bi bi-truck text-primary"></i> Free worldwide shipping</li>
                    <li><i class="bi bi-shield-check text-primary"></i> 2-year warranty</li>
                    <li><i class="bi bi-arrow-clockwise text-primary"></i> Easy returns within 30 days</li>
                </ul>
                <p class="text-muted mt-3">
                    Created: @Model.CreatedAt <br />
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <span>Last Updated: @Model.UpdatedAt</span>
                    }
                </p>

            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <ul class="nav nav-pills mb-3" id="pills-tab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="desc-tab" data-bs-toggle="pill" data-bs-target="#desc" type="button">Description</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="specs-tab" data-bs-toggle="pill" data-bs-target="#specs" type="button">Specifications</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="reviews-tab" data-bs-toggle="pill" data-bs-target="#reviews" type="button">Reviews</button>
                </li>
            </ul>
            <div class="tab-content bg-white border rounded-3 shadow-sm p-4">
                <div class="tab-pane fade show active" id="desc">
                    <p>@Model.Description</p>
                </div>
                <div class="tab-pane fade" id="specs">
                    <ul>
                        <li>Material: Aluminum Alloy</li>
                        <li>Dimensions: 25 x 15 x 8 cm</li>
                        <li>Weight: 1.3 kg</li>
                        <li>Color: Black / Silver</li>
                    </ul>
                </div>
                <div class="tab-pane fade" id="reviews">
                    <strong>John D.</strong> <span class="text-warning">★★★★☆</span>
                    <p>Great quality and fast delivery.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(".thumb").click(function () {
        var newSrc = $(this).attr("src");
        $("#mainImage").attr("src", newSrc);
    });

     $(".add-to-cart").click(function () {
        var productId = $(this).data("id");

        $.ajax({
            url: '/CardController1/AddToCart',
            type: 'POST',
            data: { productId: productId, quantity: 1 },
            success: function (res) {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true,
                    background: res.success ? '#4CAF50' : '#F44336', 
                    color: '#fff',
                    customClass: {
                        popup: 'colored-toast'
                    },
                    didOpen: (toast) => {
                        toast.onmouseenter = Swal.stopTimer;
                        toast.onmouseleave = Swal.resumeTimer;
                    }
                });

                if (res.success) {
                    Toast.fire({
                        icon: 'success',
                        title: res.message
                    });
                } else {
                    Toast.fire({
                        icon: 'error',
                        title: res.message
                    });
                }
            },
            error: function () {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true,
                    background: '#F44336', 
                    color: '#fff'
                });

                Toast.fire({
                    icon: 'error',
                    title: 'Something went wrong. Please try again.'
                });
            }
        });
    });



    $(".add-to-wishlist").click(function () {
        var productId = $(this).data("id");

        $.ajax({
            url: '/WishlistController1/AddToWishlist',
            type: 'POST',
            data: { productId: productId },
            success: function (res) {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true,
                    background: res.success ? '#4CAF50' : '#F44336', 
                    color: '#fff'
                });

                if (res.success) {
                    Toast.fire({
                        icon: 'success',
                        title: res.message
                    });
                } else {
                    Toast.fire({
                        icon: 'error',
                        title: res.message
                    });
                }
            },
            error: function () {
                const Toast = Swal.mixin({
                    toast: true,
                    position: 'bottom-end',
                    showConfirmButton: false,
                    timer: 2500,
                    timerProgressBar: true,
                    background: '#F44336',
                    color: '#fff'
                });

                Toast.fire({
                    icon: 'error',
                    title: 'Network error, please try again.'
                });
            }
        });
    });
</script>
