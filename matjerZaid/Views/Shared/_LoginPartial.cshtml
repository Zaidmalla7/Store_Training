@using Microsoft.AspNetCore.Identity
@using StoreOn.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var username = UserManager.GetUserName(User)?.Substring(0, 6);
}

<!-- الحساب والدخول بنفس شكل الزر في الحالتين -->
<div class="dropdown m-2">
    <a href="#" id="defaultDropdown" data-bs-toggle="dropdown" data-bs-auto-close="true" aria-expanded="false"
       class="btn btn-outline-primary rounded-pill px-4 py-1 fw-semibold d-inline-flex align-items-center gap-2 text-decoration-none">

        <i class="bi bi-box-arrow-in-right"></i>
        @if (SignInManager.IsSignedIn(User))
        {

            <span>@username...</span>
        }
        else
        {
            <span>Login</span>
        }
    </a>

    <!-- القائمة المنسدلة -->
    <ul class="dropdown-menu dropdown-menu-end shadow rounded-3 mt-2 border-0" aria-labelledby="defaultDropdown">
        @if (SignInManager.IsSignedIn(User))
        {
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2" asp-area="Identity" asp-page="/Account/Manage/Index">
                    <i class="fa-solid fa-sliders text-primary"></i> Profile Settings
                </a>
            </li>
            <li>
                <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                    <button id="logout" type="submit" class="dropdown-item d-flex align-items-center gap-2 text-white bg-danger">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
                    </button>
                </form>
            </li>
        }
        else
        {
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2" asp-area="Identity" asp-page="/Account/Register">
                    <i class="fas fa-user-plus text-primary"></i> Create Account
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex align-items-center gap-2 bg-primary text-white rounded-2" asp-area="Identity" asp-page="/Account/Login">
                    <i class="fa-solid fa-arrow-right-to-bracket"></i> Login
                </a>
            </li>
        }
    </ul>
</div>
