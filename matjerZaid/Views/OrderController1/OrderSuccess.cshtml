@{
}
@using Microsoft.AspNetCore.Identity
@using StoreOn.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@model ECApp.Model.Database.Order;


@{
    var appUser = await UserManager.GetUserAsync(User);
    var username = appUser?.UserName ?? "User";
    string orderStatus = Model.Status.Name;
   
    var steps = new List<(string Key, string Title, string Icon, string Color)>
    {
        ("Pending", "Pending", "fa-hourglass-start", "warning"),
        ("Confirmed", "Confirmed", "fa-circle-check", "primary"),
        ("Shipped", "Shipped", "fa-box", "info"),
        ("OutForDelivery", "Out for Delivery", "fa-truck", "orange"), // custom
        ("Delivered", "Delivered", "fa-gift", "success")
    };

    var statusIndex = steps.FindIndex(s =>
        s.Key.Equals(orderStatus, StringComparison.OrdinalIgnoreCase));

    var progressPercent = ((statusIndex + 1) * 100) / steps.Count;
        var currentStep = steps[statusIndex]; 

}
<div class="container my-5">

    <div class="alert alert-success text-center rounded-3 shadow-sm mb-4">
        ✅ Your order has been placed successfully!
    </div>

    <div class="card shadow-lg border-0 rounded-4 p-4 mx-auto" style="max-width: 950px;">

        <div class="text-center mb-5">
            <i class="bi bi-bag-check-fill text-success" style="font-size: 4rem;"></i>
            <h2 class="mt-3">Order Confirmed 🎉</h2>
            <p class="text-muted">
                Thank you for shopping with us! A confirmation email has been sent to
                <strong>@username</strong>
            </p>
        </div>
                  <div class="text-end">
    <span class="badge bg-@currentStep.Color text-white px-3 py-2 fs-6 shadow-sm">
        @currentStep.Title
    </span>
</div>

      <div class="mb-5">
    <h5 class="fw-bold mb-5">Order Progress</h5>
    <div class="position-relative">
        <div class="progress" style="height: 12px;">
            <div class="progress-bar bg-@steps[statusIndex].Color" style="width:@progressPercent%;"></div>
        </div>

        <div class="d-flex justify-content-between position-absolute top-50 start-0 w-100"
             style="transform: translateY(-50%);">

            @for (int i = 0; i < steps.Count; i++)
            {
                var step = steps[i];

                bool isCompleted = i < statusIndex;   
                bool isCurrent   = i == statusIndex;  
                bool isPending   = i > statusIndex;   

                <div class="text-center" style="width:20%;">
                    <div class="rounded-circle 
                        @(isCompleted ? "bg-success text-white shadow" : 
                          isCurrent ? $"bg-{step.Color} text-white shadow" : 
                          "bg-light border text-muted shadow-sm") 
                        d-flex align-items-center justify-content-center mx-auto"
                         style="width: 45px; height: 45px;">
                        
                        @if (isCompleted)
                        {
                            <i class="fa-solid fa-check"></i> 
                        }
                        else
                        {
                            <i class="fa-solid @step.Icon"></i>
                        }
                    </div>
                    <small class="d-block mt-2 fw-semibold 
                        @(isCompleted ? "text-success" : isCurrent ? $"text-{step.Color}" : "")">
                        @step.Title
                    </small>
                </div>
            }
        </div>
    </div>
</div>
        <!-- Products table -->
        <div class="mb-4">
            <h5 class="fw-bold">Products</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Qty</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@item.Product.ProductImages.First().ImageUrl"
                                             class="img-thumbnail rounded me-3"
                                             style="width: 60px; height: 60px; object-fit: cover;"
                                             alt="Product">
                                             <span>@item.Product.Name</span>
                                    </div>
                                </td>
                                <td>@item.Quantity</td>
                                <td>$@item.Price.ToString("N2")</td>
                                <td>$@item.Subtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Totals -->
        <div class="mb-4 text-end">
            <p class="mb-1"><strong>Subtotal:</strong> $@Model.TotalPrice.ToString("N2")</p>
            <p class="mb-1"><strong>Shipping:</strong> $0.00</p>
            <p class="mb-0 fs-5"><strong>Total:</strong> $@Model.TotalPrice.ToString("N2")</p>
        </div>

        <div class="mb-4">
            <h5 class="fw-bold">Delivery Information</h5>
            <div class="border rounded-3 p-3">
                <p class="mb-1"><strong>Address:</strong> @Model.ShippingAddress</p>
                <p class="mb-0"><strong>Estimated Delivery:</strong> Sep 7 - Sep 10, 2025</p>
            </div>
        </div>

        <div class="text-center d-flex justify-content-center gap-3 mt-4">
            <a onclick="history.back()" class="btn btn-outline-secondary px-4">Continue Shopping</a>
            <a asp-action="TrackYourOrder" asp-controller="OrderController1" asp-route-orderId="@Model.OrderId" class="btn btn-danger px-4">Track Your Order</a>
        </div>
    </div>
</div>
