@{
}
@model List<ECApp.Model.Data.Wishlis>

@{
    ViewData["Title"] = "Wishlist";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<style>
    .wishlist-header {
        font-weight: 700;
        font-size: 1.8rem;
        border-bottom: 2px solid #eee;
        padding-bottom: 10px;
        margin-bottom: 25px;
    }

    .wishlist-item {
        border-bottom: 1px solid #eaeaea;
        padding: 20px 0;
        transition: all 0.3s ease;
    }

        .wishlist-item img {
            width: 90px;
            height: 90px;
            object-fit: cover;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

    .price-info del {
        font-size: 0.9rem;
        color: #ff5722;
    }

    .btn-red {
        background-color: #dc3545;
        color: white;
        border: none;
    }

        .btn-red:hover {
            background-color: #bb2d3b;
        }

</style>

<div class="container my-5">
    <div class="wishlist-header">❤️ My Wishlist</div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center fs-5 py-5">Your wishlist is currently empty.</div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-10 mx-auto">
                @foreach (var item in Model)
                {
                    <div class="wishlist-item d-flex justify-content-between align-items-center" id="wishlist-row-@item.WishlistId">
                        <div class="d-flex align-items-center gap-3">
                            <img src="@item.ImageUrl" alt="@item.ProductName" />
                            <div>
                                <div class="fw-semibold">@item.ProductName</div>
                                <div class="price-info mt-1">
                                    <strong class="text-success">@item.FinalPrice.ToString("C")</strong>
                                    <small class="ms-2"><del>@item.Price.ToString("C")</del></small>
                                </div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <a href="/product/details/@item.ProductId" class="btn btn-outline-dark btn-sm">View</a>
                            <form asp-action="RemoveFromWishlist" asp-controller="Wishlist" method="post">
                                <input type="hidden" name="id" value="@item.WishlistId" />
                                <button type="submit" class="btn btn-red btn-sm"><i class="fas fa-trash"></i></button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
