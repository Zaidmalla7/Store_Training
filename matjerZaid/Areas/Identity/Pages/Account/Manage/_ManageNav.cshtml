@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    var source = ViewData["Source"] as string;

}

<div class="list-group list-group-flush shadow-sm rounded bg-white">
    <a class="list-group-item list-group-item-action fw-semibold @ManageNavPages.IndexNavClass(ViewContext)" asp-page="./Index" > 
        👤 Profile
    </a>
    <a class="list-group-item list-group-item-action fw-semibold @ManageNavPages.EmailNavClass(ViewContext)" asp-page="./Email" asp-route-source="@source">
        📧 Email
    </a>
    <a class="list-group-item list-group-item-action fw-semibold @ManageNavPages.ChangePasswordNavClass(ViewContext)" asp-page="./ChangePassword" asp-route-source="@source">
        🔒 Password
    </a>
    @if (hasExternalLogins)
    {
        <a class="list-group-item list-group-item-action fw-semibold @ManageNavPages.ExternalLoginsNavClass(ViewContext)" asp-page="./ExternalLogins" asp-route-source="@source">
            🌐 External Logins
        </a>
    }
    <a class="list-group-item list-group-item-action fw-semibold @ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext)" asp-page="./TwoFactorAuthentication" asp-route-source="@source">
        ✅ Two-Factor Auth
    </a>
    <a class="list-group-item list-group-item-action text-danger fw-semibold @ManageNavPages.PersonalDataNavClass(ViewContext)" asp-page="./PersonalData" asp-route-source="@source">
        🗑️ Personal Data
    </a>
</div>
